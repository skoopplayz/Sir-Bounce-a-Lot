[node name="Text" type="Label" parent="ControlsPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 0.22, 0.3, 1)
theme_override_font_sizes/font_size = 15
text = "• [A / D / Left / Right]: Move horizontally with bouncy inertia.
• [SPACE / W / Up]: Jump snappy and high.
• [S / DOWN] on Ground: SQUASH & CHARGE! Hold to squash like an elastic spring, release to catapult into an astronomical SUPER BOUNCE!
• [S / DOWN] in Mid-Air: GROUND POUND! Slam down fast, trigger shockwaves, launch seesaws and pop breakables!
• TRAMPOLINES: Time your jump right as you touch a trampoline for a PERFECT BOUNCE!
• SEESAW CATAPULTS: Ground pound one side to launch objects or yourself to the castle spires!
• DRAGON BOSS: Bounce high and ground pound onto the dragon's bouncy belly weak point!"
autowrap_mode = 2

